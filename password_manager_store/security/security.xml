<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Module category -->
    <record id="module_category_password_manager" model="ir.module.category">
        <field name="name">Password Manager</field>
        <field name="description">Manage access to Password Manager Store</field>
        <field name="sequence">100</field>
    </record>

    <!-- Privilege record (required in Odoo 19: category_id on res.groups is removed) -->
    <record id="privilege_password_manager_store" model="res.groups.privilege">
        <field name="name">Password Manager Store</field>
        <field name="category_id" ref="module_category_password_manager"/>
    </record>

    <!-- Password Store Administrator group -->
    <record id="group_password_store_admin" model="res.groups">
        <field name="name">Password Store Administrator</field>
        <field name="privilege_id" ref="privilege_password_manager_store"/>
        <field name="implied_ids" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
