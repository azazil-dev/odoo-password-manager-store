<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================== -->
    <!-- Inherit res.users FULL form (Settings > Users)                -->
    <!-- ============================================================== -->
    <record id="view_users_password_form" model="ir.ui.view">
        <field name="name">res.users.password.form</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='account_security']" position="after">
                <page string="Password Store" name="page_password_store"
                    groups="password_manager_store.group_password_store_admin">
                    <group>
                        <field name="key_missing" invisible="1"/>
                        <field name="password_encrypted" invisible="1"/>
                        <field name="has_stored_password" invisible="1"/>

                        <div class="alert alert-warning mb-3" role="alert"
                            invisible="not key_missing">
                            <strong>⚠ Master key not configured.</strong>
                            Add <code>password_store_key = &lt;key&gt;</code> to
                            <code>odoo.conf</code> and restart Odoo.
                        </div>

                        <group string="Stored Password">
                            <div class="mb-2">
                                <span class="badge bg-success"
                                    invisible="not has_stored_password">
                                    <i class="fa fa-check me-1"/>Password stored
                                </span>
                                <span class="badge bg-secondary"
                                    invisible="has_stored_password">
                                    <i class="fa fa-times me-1"/>No password stored yet
                                </span>
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                <button name="%(password_manager_store.action_set_user_password_wizard)d"
                                    type="action"
                                    string="Set &amp; Store Password"
                                    icon="fa-key"
                                    class="btn btn-primary btn-sm"
                                    context="{'default_user_id': id}"
                                    invisible="not id"/>
                                <button name="action_show_user_password"
                                    type="object"
                                    string="Show Password"
                                    icon="fa-eye"
                                    class="btn btn-secondary btn-sm"
                                    invisible="not has_stored_password"/>
                                <button name="action_copy_user_password"
                                    type="object"
                                    string="Copy Password"
                                    icon="fa-copy"
                                    class="btn btn-secondary btn-sm"
                                    invisible="not has_stored_password"/>
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
