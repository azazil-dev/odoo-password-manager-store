<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List view: read-only, ordered newest first -->
    <record id="view_password_store_access_log_list" model="ir.ui.view">
        <field name="name">password.store.access.log.list</field>
        <field name="model">password.store.access.log</field>
        <field name="arch" type="xml">
            <list string="Audit Log" create="false" edit="false" delete="false">
                <field name="create_date" string="Date / Time"/>
                <field name="user_id"/>
                <field name="account_id" optional="show"/>
                <field name="account_name" optional="hide"/>
                <field name="action"/>
                <field name="ip_address" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_password_store_access_log_search" model="ir.ui.view">
        <field name="name">password.store.access.log.search</field>
        <field name="model">password.store.access.log</field>
        <field name="arch" type="xml">
            <search string="Search Audit Log">
                <field name="user_id" string="User"/>
                <field name="account_name" string="Account Name"/>
                <field name="action" string="Action"/>
                <filter string="Show Password" name="action_show"
                    domain="[('action', '=', 'show')]"/>
                <filter string="Copy Password" name="action_copy"
                    domain="[('action', '=', 'copy')]"/>
                <filter string="Deleted" name="action_unlink"
                    domain="[('action', '=', 'unlink')]"/>
                <group expand="0" string="Group By">
                    <filter string="User" name="group_user"
                        context="{'group_by': 'user_id'}"/>
                    <filter string="Action" name="group_action"
                        context="{'group_by': 'action'}"/>
                    <filter string="Date" name="group_date"
                        context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_password_store_access_log" model="ir.actions.act_window">
        <field name="name">Audit Log</field>
        <field name="res_model">password.store.access.log</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_password_store_access_log_search"/>
    </record>

</odoo>
