<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ======== Category ======== -->
    <record id="view_password_store_category_list" model="ir.ui.view">
        <field name="name">password.store.category.list</field>
        <field name="model">password.store.category</field>
        <field name="arch" type="xml">
            <tree string="Categories" editable="bottom">
                <field name="name"/>
                <field name="account_count" string="Accounts"/>
            </tree>
        </field>
    </record>

    <record id="view_password_store_category_form" model="ir.ui.view">
        <field name="name">password.store.category.form</field>
        <field name="model">password.store.category</field>
        <field name="arch" type="xml">
            <form string="Category">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="account_count" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_password_store_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">password.store.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ======== Tag ======== -->
    <record id="view_password_store_tag_list" model="ir.ui.view">
        <field name="name">password.store.tag.list</field>
        <field name="model">password.store.tag</field>
        <field name="arch" type="xml">
            <tree string="Tags" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </tree>
        </field>
    </record>

    <record id="action_password_store_tag" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">password.store.tag</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
