<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_set_user_password_wizard_form" model="ir.ui.view">
        <field name="name">password.store.set.user.password.wizard.form</field>
        <field name="model">password.store.set.user.password.wizard</field>
        <field name="arch" type="xml">
            <form string="Set &amp; Store Password">
                <sheet>
                    <group>
                        <field name="user_id" invisible="1"/>
                        <field name="user_login" readonly="1"/>
                        <field name="new_password" password="True"/>
                        <field name="confirm_password" password="True"/>
                    </group>
                    <p class="text-muted small">
                        This will update the user's Odoo login password and
                        store an encrypted copy that can be revealed later.
                    </p>
                </sheet>
                <footer>
                    <button name="action_set_password"
                        type="object"
                        string="Set &amp; Store Password"
                        class="btn btn-primary"/>
                    <button string="Cancel"
                        class="btn btn-secondary"
                        special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_set_user_password_wizard" model="ir.actions.act_window">
        <field name="name">Set &amp; Store Password</field>
        <field name="res_model">password.store.set.user.password.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_set_user_password_wizard_form"/>
        <field name="target">new</field>
    </record>

</odoo>
